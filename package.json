{
  "name": "sensor-monitor",
  "version": "1.0.0",
  "description": "Monitor de sensor ambiental em tempo real",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build-web.mjs",
    "bridge": "node bridge/collector.mjs",
    "bridge:once": "node bridge/collector.mjs --once",
    "bridge:check": "node bridge/collector.mjs --once --dry-run",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "node-fetch": "^3.3.2"
  }
}
